global:
  image:
    tag: "{{ argocd_image_tag }}"
  logging:
    level: info

server:
  service:
    type: NodePort
    nodePortHttps: {{ argocd_nodeport }}
  resources:
    requests:
      cpu: 100m
      memory: 128Mi
    limits:
      cpu: 500m
      memory: 256Mi

controller:
  resources:
    requests:
      cpu: 250m
      memory: 512Mi
    limits:
      cpu: "1"
      memory: 2Gi # 1Gi OOMKilled on 2026-11-19 with 8 apps syncing at once (Traefik charts carry ~25 CRDs each)

repoServer:
  resources:
    requests:
      cpu: 100m
      memory: 128Mi
    limits:
      cpu: 500m
      memory: 256Mi

applicationSet:
  resources:
    requests:
      cpu: 50m
      memory: 64Mi
    limits:
      cpu: 250m
      memory: 128Mi

redis:
  resources:
    requests:
      cpu: 50m
      memory: 64Mi
    limits:
      cpu: 250m
      memory: 128Mi

notifications:
  enabled: false

dex:
  enabled: false

configs:
  params:
    server.insecure: "true"
