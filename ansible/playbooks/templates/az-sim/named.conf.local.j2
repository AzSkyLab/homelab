// Managed by Ansible (az-ingress-sim)
// az.home.lab = the delegated "Azure DNS" zone from the ingress blueprint.
// RFC2136 dynamic updates (TSIG) let the health flipper rewrite records.

include "/etc/bind/keys/flipper.key";

zone "az.home.lab" {
    type master;
    file "/var/lib/bind/db.az.home.lab";
    allow-update { key "flipper-key"; };
};
