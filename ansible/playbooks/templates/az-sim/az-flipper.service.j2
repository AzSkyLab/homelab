# Managed by Ansible (az-ingress-sim)
[Unit]
Description=DNS health flipper for az.home.lab (ingress blueprint sim)
After=network-online.target named.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/az-flipper.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
