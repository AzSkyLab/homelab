# Managed by Ansible (az-ingress-sim) — region: {{ region }}
# F5 BIG-IP sim: wildcard VS *.az.home.lab, TLS terminate (internal CA),
# re-encrypt to the "AGW" (local nginx), priority-group backup to the
# REMOTE region's AGW ({{ peer_ip }}) — blueprint §6.1 + §8 layer A.

global
    log /dev/log local0
    maxconn 2048

defaults
    mode http
    log global
    option httplog
    timeout connect 5s
    timeout client 30s
    timeout server 30s

frontend fe_az_wildcard
    bind :443 ssl crt /etc/haproxy/certs/az-wildcard.pem
    http-request set-header X-Forwarded-For %[src]
    http-request set-header X-Forwarded-Proto https
    default_backend be_agw

backend be_agw
    option httpchk
    http-check send meth GET uri /healthz hdr Host app1.az.home.lab
    default-server ssl verify none check inter 5s fall 3 rise 2
    server agw-local 127.0.0.1:8443
    server agw-remote {{ peer_ip }}:8443 backup

# ops visibility for game days
listen stats
    bind :8404
    stats enable
    stats uri /
    stats refresh 5s
