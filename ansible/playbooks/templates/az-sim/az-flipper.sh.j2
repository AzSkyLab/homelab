#!/usr/bin/env bash
# Managed by Ansible (az-ingress-sim)
# DNS health flipper — lab implementation of blueprint §8 layer B.
# Probes each region's HAProxy VIP through the FULL chain (TLS -> nginx -> k3s env)
# and rewrites app1.az.home.lab via RFC2136 when the active region dies.
# East is primary; failback is automatic after RISE consecutive good probes.
set -u

RECORD="app1.az.home.lab"
EAST_IP="10.0.40.61"
CENTRAL_IP="10.0.40.62"
TTL=30
INTERVAL=15
FALL=3   # consecutive failures before a region is considered down
RISE=2   # consecutive successes before a region is considered up
CA="/usr/local/share/ca-certificates/home-lab-root-ca.crt"
KEYFILE="/etc/bind/keys/flipper.key"

fails_east=0 ok_east=0 fails_central=0 ok_central=0

probe() { # $1 = region VIP
  local code
  code=$(curl -so /dev/null -w '%{http_code}' --max-time 3 \
    --cacert "$CA" --resolve "${RECORD}:443:$1" "https://${RECORD}/healthz" 2>/dev/null) || true
  [[ "$code" == "200" ]]
}

current_ip() { dig +short @127.0.0.1 "$RECORD" A | head -1; }

set_record() { # $1 = new IP
  nsupdate -k "$KEYFILE" <<EOF
server 127.0.0.1
update delete ${RECORD} A
update add ${RECORD} ${TTL} A $1
send
EOF
}

echo "az-flipper starting: ${RECORD} east=${EAST_IP} central=${CENTRAL_IP} interval=${INTERVAL}s fall=${FALL} rise=${RISE}"

while true; do
  if probe "$EAST_IP"; then ok_east=$((ok_east + 1)); fails_east=0; else fails_east=$((fails_east + 1)); ok_east=0; fi
  if probe "$CENTRAL_IP"; then ok_central=$((ok_central + 1)); fails_central=0; else fails_central=$((fails_central + 1)); ok_central=0; fi

  cur=$(current_ip)
  desired="$cur"

  if (( ok_east >= RISE )); then
    desired="$EAST_IP"                 # primary healthy -> primary wins (failback)
  elif (( fails_east >= FALL && ok_central >= RISE )); then
    desired="$CENTRAL_IP"              # primary down, secondary healthy -> flip
  fi
  # both down: leave the record alone (nowhere better to point)

  if [[ -n "$desired" && "$desired" != "$cur" ]]; then
    echo "FLIP: ${RECORD} ${cur:-<none>} -> ${desired} (east fails=${fails_east} ok=${ok_east} | central fails=${fails_central} ok=${ok_central})"
    set_record "$desired"
  fi

  sleep "$INTERVAL"
done
